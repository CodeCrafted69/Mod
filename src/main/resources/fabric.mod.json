{
  "schemaVersion": 1,
  "id": "termuxcommandbridge",
  "version": "${version}",
  "name": "Termux Command Bridge",
  "description": "An opt-in, token-authenticated web queue that sends Minecraft commands as the connected player.",
  "authors": ["Jarvis"],
  "license": "MIT",
  "environment": "client",
  "entrypoints": {
    "client": [
      "com.jarvis.commandbridge.TermuxCommandBridgeClient"
    ]
  },
  "depends": {
    "fabricloader": ">=0.18.0",
    "minecraft": "~1.21.11",
    "java": ">=21",
    "fabric-api": "*"
  }
}
